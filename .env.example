# Copy to .env and adjust. Safe defaults are set; no secrets are required.

# Host transcripts: docker-compose mounts $HOME/.claude/projects read-only (fixed path).

# Path inside the backend container where the transcripts are mounted.
CLAUDE_PROJECTS_DIR=/claude/projects

# SQLite database file inside the backend container (persisted in a volume).
DB_PATH=/data/usage.db

# Background sync interval in seconds. Bounded to 10..3600.
SYNC_INTERVAL_S=60

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend URL used by the frontend on the server side only (never exposed to the browser).
# Falls back to http://localhost:8000 when unset.
BACKEND_URL=http://backend:8000

# Host port for the frontend. It is bound to 127.0.0.1 only.
FRONTEND_PORT=3002
